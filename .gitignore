# Secrets — the GitHub App private key lands in hub/.secrets/ (see
# scripts/github-app-setup.sh). Belt-and-braces: hub/.gitignore also covers it.
.secrets/
*.pem
.env
.env.*

# client/ has no package tooling of its own — the scripts run via `uv run`,
# so nothing else ignores its bytecode.
__pycache__/
.pytest_cache/
